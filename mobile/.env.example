# IP tvojega PC-ja v Wi-Fi omrežju (ipconfig -> IPv4), NE localhost.
# Telefon mora biti na istem Wi-Fi. Brez te vrstice app uporablja produkcijski API.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1
# Google OAuth client ID (iOS) za Google Koledar – isti kot GOOGLE_CLIENT_ID v api/.env
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
