# Lokalna baza iz api/docker-compose.yml (port 5433). Privzeto geslo baze je "postgres";
# če želiš svoje, nastavi POSTGRES_PASSWORD (prebere ga docker compose) in ga uporabi tudi v DATABASE_URL.
# POSTGRES_PASSWORD=
DATABASE_URL="postgresql://sirena:postgres@localhost:5433/sirena"
# Poljuben dolg naključen niz (NE isti kot v produkciji)
JWT_SECRET=
# 32 bajtov v hex (64 znakov): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Basic auth za Swagger /docs
DOCS_USER=
DOCS_PASS=
# Google OAuth client ID (iOS) za povezavo z Google Koledarjem; brez njega /auth/google-token vrne 503
GOOGLE_CLIENT_ID=
# Glava izvoženega delovnega zapisa (Excel)
PODJETJE_NAZIV=
PODJETJE_NASLOV=
PODJETJE_KRAJ=
PORT=3000
